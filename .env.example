# Persistence: session (default until deliberate cutover) | database
PERSISTENCE_MODE=session

# Required when PERSISTENCE_MODE=database (Neon pooled / application URL)
DATABASE_URL=

# Direct / unpooled Neon URL for drizzle-kit migrations
DATABASE_URL_UNPOOLED=

# development | preview | production
APP_ENV=development

# Authentication cutover (M18): demo (default) | production
# Public production must remain demo until cutover is separately approved.
# demo + database is allowed ONLY for APP_ENV=development (local).
AUTH_MODE=demo

# Required when AUTH_MODE=production (Auth.js JWT signing). Never commit real values.
AUTH_SECRET=

# Optional Auth.js absolute URL (usually inferred on Vercel)
# AUTH_URL=

# Optional name used by db:bootstrap:company
BOOTSTRAP_COMPANY_NAME=Project X Mechanical Services

# Temporary only — used by db:bootstrap:admin for the first Admin.
# Do not leave set in permanent app configuration. Never commit real values.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_NAME=Administrator
# BOOTSTRAP_ADMIN_PASSWORD=
